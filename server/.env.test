NODE_ENV=test
DB_USERNAME=postgres
DB_PASSWORD=123
DB_DATABASE=book-worm-test
DB_HOST=127.0.0.1
DB_PORT=5433
ACCESS_TOKEN_SECRET=test-access-secret
REFRESH_TOKEN_SECRET=test-refresh-secret
JWT_SECRET=test-jwt-secret
JWT_PASS=test-jwt-pass
CLIENT_URL=http://localhost:5173

# Explicitly empty (not omitted) — some files call a bare require("dotenv").config()
# with no path, which falls back to loading the real .env for any var not
# already set. Omitting these here would let the real VAPID keys leak into
# test runs and break the "push is unconfigured in tests" assertion.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
